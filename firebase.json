{
  "hosting": {
    "site": "wppcloudai",
    "public": "public",
    "cleanUrls": true,
    "trailingSlash": true,
    "ignore": ["firebase.json", "**/.*"],
    "redirects": [
      { "source": "/digests/feed.xml", "destination": "/cloud/feed.xml", "type": 301 },
      { "source": "/digests", "destination": "/cloud/", "type": 301 },
      { "source": "/digests/:path*", "destination": "/cloud/:path*", "type": 301 }
    ],
    "headers": [
      {
        "source": "**/feed.xml",
        "headers": [
          { "key": "Content-Type", "value": "application/rss+xml; charset=utf-8" },
          { "key": "Cache-Control", "value": "public, max-age=600" }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=600" }]
      },
      {
        "source": "/css/**",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
      }
    ]
  }
}
